# MySQL - main connection (read operations)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=dashboard_wj
DB_USERNAME=root
DB_PASSWORD=

# MySQL - broadcast read-only connection (untuk broadcast_query_execute)
DB_READONLY_HOST=127.0.0.1
DB_READONLY_PORT=3306
DB_READONLY_DATABASE=dashboard_wj
DB_READONLY_USERNAME=readonly_user
DB_READONLY_PASSWORD=

# Laravel app base URL (untuk write operations: recreateInvoice, expireInvoice)
APP_BASE_URL=http://localhost:8000
APP_SESSION_COOKIE=laravel_session
# Token auth jika pakai API token (opsional)
APP_API_TOKEN=
